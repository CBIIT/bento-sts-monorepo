{
  "name": "mdb-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1 --port 25173 --strictPort",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1 --port 25173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "test": "vitest run --config vite.config.ts",
    "generate:api": "node scripts/generate-api.mjs",
    "test:e2e": "playwright test --config playwright.browse.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.83.0",
    "@uswds/uswds": "3.14.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  }
}
